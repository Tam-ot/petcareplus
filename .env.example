# GEMINI_API_KEY: Optional (only if using Gemini API features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server port (Render / Railway automatically inject PORT)
PORT="3000"

# Admin account for Blog publishing & scheduling
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@petcareplus.vn"
ADMIN_PASSWORD="Petcare@2026"
ADMIN_SECRET="change-me-to-a-long-random-secret"

# Supabase (Database + Storage) — Leave empty to use local JSON/uploads fallback
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="petcare-media"
